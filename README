<script>
(function(){
  /* ── Plate palette ──────────────────────────────────────── */
  var DEFAULT_BRAND = 'ocean';
  var stored = null;
  try { stored = localStorage.getItem('ki-brand'); } catch(e){}
  var brand = stored || DEFAULT_BRAND;
  function setBrand(b, persist){
    brand = b;
    document.documentElement.setAttribute('data-brand', b);
    document.querySelectorAll('.sw').forEach(function(s){
      s.setAttribute('aria-pressed', s.getAttribute('data-brand') === b ? 'true' : 'false');
    });
    if(persist){ try { localStorage.setItem('ki-brand', b); } catch(e){} }
    if(window.__repaint) window.__repaint();
  }
  document.getElementById('swatcher').addEventListener('click', function(e){
    var b = e.target.closest('.sw');
    if(b) setBrand(b.getAttribute('data-brand'), true);
  });
  setBrand(brand, false);

  /* ── Router ─────────────────────────────────────────────── */
  var pages = Array.prototype.slice.call(document.querySelectorAll('.page'));
  var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a'));
  function route(){
    var h = (location.hash || '#/').replace('#/','');
    var found = false;
    pages.forEach(function(p){
      var on = p.getAttribute('data-page') === h;
      if(on) found = true;
      p.classList.toggle('on', on);
    });
    if(!found){ pages[0].classList.add('on'); h=''; }
    links.forEach(function(a){
      a.classList.toggle('on', a.getAttribute('href') === '#/' + h);
    });
    document.getElementById('navLinks').classList.remove('open');
    document.getElementById('navToggle').setAttribute('aria-expanded','false');
    window.scrollTo(0,0);
  }
  window.addEventListener('hashchange', route);
  route();

  var t = document.getElementById('navToggle');
  t.addEventListener('click', function(){
    var n = document.getElementById('navLinks');
    var open = n.classList.toggle('open');
    t.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  /* ── Enquiry form → email ───────────────────────────────── */
  var form = document.getElementById('enq');
  form.addEventListener('submit', function(e){
    e.preventDefault();
    var d = new FormData(form);
    var body = 'Name: ' + (d.get('name')||'') + '\n'
             + 'Email: ' + (d.get('email')||'') + '\n'
             + 'Surfing: ' + (d.get('surf')||'') + '\n\n'
             + (d.get('msg')||'');
    var href = 'mailto:mikey@kicommunities.com?subject='
             + encodeURIComponent('Ki Communities enquiry — ' + (d.get('name')||''))
             + '&body=' + encodeURIComponent(body);
    var note = document.getElementById('enqNote');
    try { window.location.href = href; } catch(err){}
    if (navigator.clipboard) {
      navigator.clipboard.writeText(body + '\n\nSend to: mikey@kicommunities.com').then(function(){
        note.textContent = 'Opening your email app — the message is also copied to your clipboard.';
      }).catch(function(){
        note.textContent = 'Opening your email app. If nothing happens, write to mikey@kicommunities.com.';
      });
    } else {
      note.textContent = 'Opening your email app. If nothing happens, write to mikey@kicommunities.com.';
    }
  });

  /* ── Swell field — bathymetric contours refracting on the reef ── */
  function css(v){ return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function drawField(cv, opts){
    var ctx = cv.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var w = cv.clientWidth, h = cv.clientHeight;
    if(!w || !h) return;
    cv.width = w * dpr; cv.height = h * dpr;
    ctx.setTransform(dpr,0,0,dpr,0,0);

    var accent = opts.line || css('--clay') || '#A8522F';
    var ground = css('--ground') || '#EBE2D3';
    ctx.fillStyle = opts.bg || ground;
    ctx.fillRect(0,0,w,h);

    var rows = opts.rows || 46;
    var reefX = w * (opts.reefX || 0.72);
    var reefY = h * (opts.reefY || 0.62);

    for(var i=0;i<rows;i++){
      var t = i/(rows-1);
      var baseY = h * (opts.top||0.06) + t * h * (opts.span||0.94);
      ctx.beginPath();
      for(var x=0;x<=w;x+=3){
        var nx = x/w;
        // distance to the reef point drives refraction: waves bend and pile up near it
        var dx = (x-reefX)/w, dy = (baseY-reefY)/h;
        var d = Math.sqrt(dx*dx + dy*dy);
        var refract = Math.exp(-d*d*7) * 26 * (0.35 + t);
        var amp = (2 + t*t*30) * (opts.amp||1);
        var ph = opts.phase;
        var y = baseY
              + Math.sin(nx*5.1 + ph + t*2.2) * amp
              + Math.sin(nx*11.3 - ph*1.6 + t*3.4) * amp*0.34
              + Math.sin(nx*2.1 + ph*0.5) * amp*0.5
              - refract * Math.sin(nx*3.4 + ph*0.8);
        if(x===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
      }
      var alpha = (opts.minA||0.07) + t*t*(opts.maxA||0.5);
      ctx.strokeStyle = accent;
      ctx.globalAlpha = alpha;
      ctx.lineWidth = 0.5 + t*1.15;
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }

  var hero = document.getElementById('swell');
  var phase = 0, raf = null;
  function heroOpts(p){
    return {
      phase: p, rows: 52, amp: 1, reefX: .74, reefY: .58,
      bg: css('--brand') || '#A8522F',
      line: css('--brand-line-col') || '#F0E4D2',
      minA: .16, maxA: .85
    };
  }
  function tick(){
    phase += 0.0032;
    drawField(hero, heroOpts(phase));
    raf = requestAnimationFrame(tick);
  }
  function startHero(){
    if(!hero) return;
    if(raf){ cancelAnimationFrame(raf); raf = null; }
    if(reduce){ drawField(hero, heroOpts(1.4)); return; }
    tick();
  }

  var plateOpts = {
    surf:   {rows:44, amp:1.7, reefX:.30, reefY:.72,phase:0.6, top:.02, span:.96, maxA:.66},
    spa:    {rows:34, amp:.5,  reefX:.5,  reefY:.5, phase:2.4, top:.04, span:.92, maxA:.4},
    jungle: {rows:52, amp:.9,  reefX:.85, reefY:.28,phase:4.1, top:.02, span:.96, maxA:.5},
    hero2:  {rows:60, amp:1.2, reefX:.62, reefY:.52,phase:1.1, top:.02, span:.96, maxA:.5},
    spa2:   {rows:30, amp:.6,  reefX:.2,  reefY:.4, phase:3.3, top:.04, span:.92, maxA:.38},
    chart:  {rows:44, amp:1.0, reefX:.45, reefY:.66,phase:5.2, top:.02, span:.96, maxA:.46}
  };
  function paintPlates(){
    document.querySelectorAll('[data-plate]').forEach(function(cv){
      var o = plateOpts[cv.getAttribute('data-plate')] || plateOpts.chart;
      var onPanel = cv.closest('.reason');
      var dark = cv.closest('.dark');
      var over = onPanel
        ? {bg: css('--jungle'), line: '#E4D5B8', minA: .12}
        : (dark ? {bg: css('--jungle')} : {});
      drawField(cv, Object.assign({}, o, over));
    });
  }

  function repaintAll(){ startHero(); paintPlates(); }
  window.__repaint = repaintAll;
  window.addEventListener('resize', function(){ clearTimeout(window.__rt); window.__rt = setTimeout(repaintAll, 180); });
  window.addEventListener('hashchange', function(){ setTimeout(paintPlates, 60); });
  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(repaintAll); }
  var mq = window.matchMedia('(prefers-color-scheme: dark)');
  (mq.addEventListener ? mq.addEventListener('change', repaintAll) : mq.addListener(repaintAll));
  repaintAll();
})();
</script>

